{
  "name": "freebusy-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Query-only native Zimbra and Microsoft 365 free/busy gateway",
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "tsx src/scaffold.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:contract && npm run test:integration && npm run test:security && npm run build"
  },
  "dependencies": {
    "@azure/identity": "4.13.3",
    "@js-temporal/polyfill": "0.5.1",
    "fastify": "5.12.5",
    "lru-cache": "11.5.3",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "saxes": "6.0.0",
    "xmlbuilder2": "4.0.3"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
